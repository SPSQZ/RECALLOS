# Nebius Token Factory & NVIDIA Model Configuration (Member 1)
# Replace 'your_actual_nebius_api_key' with your actual key from Nebius Console.
NEBIUS_API_KEY=your_actual_nebius_api_key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA Nemotron Model Stack
# Fast everyday route (low latency)
MODEL_FAST=nvidia/llama-3.1-nemotron-70b-instruct

# Complex multi-step reasoning route
MODEL_COMPLEX=nvidia/Nemotron-3-Ultra-550b-a55b

# Dynamic Routing Threshold (0.0 to 1.0)
ROUTER_COMPLEXITY_THRESHOLD=0.40

# Local developer simulation fallback (set to false to enforce strict cloud errors)
ENABLE_MOCK_FALLBACK=true
